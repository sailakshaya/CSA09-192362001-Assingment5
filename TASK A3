Design a Generic Data-Access Interface
public interface Dao<T, K> {
    void insert(T entity) throws SQLException;
    T findById(K id) throws SQLException;
    List<T> findAll() throws SQLException;
    void update(T entity) throws SQLException;
    void delete(K id) throws SQLException;
}
public class StudentDao implements Dao<Student, String> {
    private final Connection con;
    public StudentDao(Connection con) { this.con = con; }

    public void insert(Student s) throws SQLException {
        String sql = "INSERT INTO student(reg_no, name, email) VALUES (?, ?, ?)";
        try (PreparedStatement ps = con.prepareStatement(sql)) {
            ps.setString(1, s.getRegNo());
            ps.setString(2, s.getName());
            ps.setString(3, s.getEmail());
            ps.executeUpdate();
        }
    }
    // Implement findById, findAll, update and delete similarly,
    // mapping ResultSet columns to Student fields.
}
